<?xml version="1.0" encoding="utf-8"?>
<!-- ① 안내문 목록: 인사말, 가장 급한 안내문 카드, 상태 개수, 나머지 목록, 아래 버튼 두 개 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:paddingHorizontal="4dp"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_logo" />

                <!-- 아이콘만 두면 무엇인지 모를 수 있어 "설정" 글자를 함께 -->
                <Button
                    android:id="@+id/btnSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/settings_title"
                    android:textColor="@color/accent_text"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_settings"
                    app:iconPadding="6dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/accent_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtGreeting"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="4dp"
                android:textColor="@color/sub" />

            <TextView
                android:id="@+id/txtHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityHeading="true"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="4dp"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:targetApi="28" />

            <!-- 가장 먼저 챙길 안내문 (마감이 남은 것 중 가장 가까운 것) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_glass"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/hero_label"
                        android:textColor="@color/on_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_summary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHeroWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:minHeight="@dimen/touch_min"
                        android:paddingStart="18dp"
                        android:paddingEnd="12dp"
                        android:text="@string/hero_open"
                        android:textColor="@color/accent_text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_chevron_right"
                        app:drawableTint="@color/accent_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 마감 임박 / 진행 중 / 마감 지남 개수 -->
            <LinearLayout
                android:id="@+id/counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/txtCountUrgent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/sub"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtCountActive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/sub"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtCountPassed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/sub"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtOthers"
                style="@style/Heading"
                android:layout_marginBottom="0dp"
                android:text="@string/list_others" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/noticeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="2dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txtEmpty"
                style="@style/Body"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/empty_list"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnImport"
            style="@style/Button.Light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/import_photo"
            app:icon="@drawable/ic_photo" />

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/capture_notice"
            app:icon="@drawable/ic_camera" />
    </LinearLayout>

</LinearLayout>
