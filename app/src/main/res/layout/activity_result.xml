<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ResultActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 요약 중 · 실패 안내 -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/summarizing"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="72dp"
                android:text="@string/retry"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/summaryGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 원문 대조 배지: 통과(초록 체크) 또는 불일치(주황 경고) -->
                <TextView
                    android:id="@+id/txtVerify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:lineBreakWordStyle="phrase"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:targetApi="33" />

                <!-- 세 줄 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="20dp">

                        <TextView
                            style="@style/SummaryLabel"
                            android:text="@string/label_what" />

                        <TextView
                            android:id="@+id/txtLine1"
                            style="@style/SummaryLine" />

                        <TextView
                            style="@style/SummaryLabel"
                            android:text="@string/label_todo" />

                        <TextView
                            android:id="@+id/txtLine2"
                            style="@style/SummaryLine" />

                        <TextView
                            style="@style/SummaryLabel"
                            android:text="@string/label_when_where" />

                        <TextView
                            android:id="@+id/txtLine3"
                            style="@style/SummaryLine" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 원문 사진을 요약 바로 아래에 펼쳐 비교한다 -->
                <Button
                    android:id="@+id/btnPhoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/show_photo"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/photo_desc"
                    android:visibility="gone" />

                <!-- 경고 한 줄: 아이콘과 글자를 함께 -->
                <TextView
                    android:id="@+id/txtWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/warning_box"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:lineBreakWordStyle="phrase"
                    android:lineSpacingExtra="4dp"
                    tools:targetApi="33"
                    android:padding="16dp"
                    android:textColor="@color/warning_text"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_warning" />

                <!-- 행동 연결: 해당하는 값이 있을 때만 보인다 -->
                <Button
                    android:id="@+id/btnSpeak"
                    style="@style/ActionButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/action_speak" />

                <Button
                    android:id="@+id/btnCalendar"
                    style="@style/ActionButton"
                    android:text="@string/action_calendar" />

                <Button
                    android:id="@+id/btnDial"
                    style="@style/ActionButton" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/ActionButton"
                    android:text="@string/action_share" />

                <Button
                    android:id="@+id/btnMap"
                    style="@style/ActionButton" />

                <TextView
                    android:id="@+id/txtTodosTitle"
                    style="@style/SummaryLabel"
                    android:layout_marginTop="24dp"
                    android:text="@string/todos_title" />

                <LinearLayout
                    android:id="@+id/todoGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/summary_note"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- AI에 보낸 글 -->
            <TextView
                style="@style/SummaryLabel"
                android:layout_marginTop="32dp"
                android:text="@string/original_title" />

            <TextView
                android:id="@+id/txtOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_body" />

            <!-- 요약에 실패한 안내문도 지울 수 있게 요약 묶음 밖에 둔다 -->
            <Button
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="@dimen/touch_min"
                android:text="@string/delete_notice"
                android:textColor="@color/warning_text"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnHome"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:minHeight="72dp"
        android:text="@string/go_home"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

</LinearLayout>
