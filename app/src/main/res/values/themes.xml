<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ThreeLinesFirst" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/sub</item>
        <!-- 한국어를 낱말 단위로 줄바꿈해 "이에요."만 다음 줄로 떨어지지 않게 (Android 13 이상) -->
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="materialButtonStyle">@style/Button</item>
        <item name="materialCardViewStyle">@style/Card</item>
        <!-- 그림자 있는 카드·버튼이 회색빛으로 물들지 않게 -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Theme.ThreeLinesFirst" parent="Base.Theme.ThreeLinesFirst" />

    <!-- 둥근 알약 모양 기본 버튼 (Material3 버튼은 기본이 완전히 둥근 모양) -->
    <style name="Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 흰 바탕에 파란 글자인 보조 버튼 -->
    <style name="Button.Light" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="iconTint">@color/accent_text</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 요약 화면 위쪽의 쪽 이동 탭. 고른 탭 색은 코드에서 바꾼다 -->
    <style name="Tab" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/body</item>
    </style>

    <!-- 바로 하기 칸: 아이콘 위, 글자 아래 -->
    <style name="Tile" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:minHeight">112dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">22dp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">30dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/accent_text</item>
    </style>

    <!-- 테두리 없이 옅은 그림자만 있는 흰 카드 -->
    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- 세 줄 요약 한 줄: 번호 동그라미 + 항목 이름 + 내용 -->
    <style name="SummaryRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <style name="SummaryNumber">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SummaryLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SummaryLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_summary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 개인정보 동의 화면의 항목 카드 -->
    <style name="ConsentIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:backgroundTint">@color/tone_blue_bg</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/accent_text</item>
    </style>

    <style name="ConsentItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ConsentItemBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
