<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ThreeLinesFirst" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.ThreeLinesFirst" parent="Base.Theme.ThreeLinesFirst" />

    <!-- 개인정보 동의 화면의 항목 제목과 설명 -->
    <style name="ConsentItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 세 줄 요약의 항목 이름과 내용 -->
    <style name="SummaryLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SummaryLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textSize">@dimen/text_summary</item>
        <!-- 한국어를 낱말 단위로 줄바꿈 (Android 13 이상, 그 아래에서는 무시) -->
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ConsentItemBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <!-- 요약 화면의 행동 버튼 -->
    <style name="ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
